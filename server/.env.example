# Copy to .env and fill in (never commit .env)

PORT=8787

# Your OpenAI key — all chat traffic uses this (users never see it)
OPENAI_API_KEY=sk-...

# Default model if client omits one
OPENAI_DEFAULT_MODEL=gpt-4o-mini

JWT_SECRET=change-me-to-a-long-random-string

# Create redeem codes via: npm run gen-codes
ADMIN_SECRET=change-me-admin-secret

# Comma-separated origins for CORS (include your PWA URL)
# Example: http://127.0.0.1:5500,http://localhost:8080,https://your-domain.com
CORS_ORIGINS=*
